rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(field) { return signedIn() && resource.data[field] == request.auth.uid; }
    function ownerUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Account creation, profile validation and all financial authority belong
      // to authenticated server APIs. Deny deletion/recreation credit resets too.
      allow write: if false;
    }
    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /wardrobe/{itemId} {
      allow read, delete: if owns('userId');
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('user_id' in request.resource.data) || request.resource.data.user_id == request.auth.uid);
      allow update: if owns('userId') && ownerUnchanged('userId')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id']);
    }
    match /outfits/{outfitId} {
      allow read: if owns('user_id');
      // Creation, deletion, item changes and flatlay projections need server
      // validation and coordination with the private generation ledger.
      allow create, delete: if false;
      allow update: if owns('user_id') && ownerUnchanged('user_id')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isFavorite', 'notes', 'updatedAt'])
        && (!('isFavorite' in request.resource.data) || request.resource.data.isFavorite is bool)
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 10000));
    }
    match /outfit_history/{entryId} {
      allow read, delete: if owns('user_id');
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if owns('user_id') && ownerUnchanged('user_id');
    }
    match /daily_outfit_suggestions/{suggestionId} {
      allow read, delete: if owns('user_id');
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if owns('user_id') && ownerUnchanged('user_id');
    }
    match /wardrobe_stats/{docId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.admin == true;
    }
    match /trends/{trendId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.admin == true;
    }
    // Includes flat_lay_requests, payment events and account-reconciliation
    // ledgers: no authenticated client, including an admin claim, can access them.
    match /{document=**} { allow read, write: if false; }
  }
}
