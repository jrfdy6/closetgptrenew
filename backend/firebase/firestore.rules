rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own wardrobe items (subcollection under users)
    match /users/{userId}/wardrobe/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own wardrobe items in the main wardrobe collection
    match /wardrobe/{itemId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }

    // Users can only read/write their own user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own profile data
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only read/write their own outfits
    match /outfits/{outfitId} {
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
    }

    // New transactional wear events are immutable to clients. Legacy entries
    // retain their existing edit policy; only the server can create receipt IDs.
    match /outfit_history/{entryId} {
      allow read: if request.auth != null &&
        resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.user_id == request.auth.uid &&
        !entryId.matches('wear-v1-.*') &&
        !request.resource.data.keys().hasAny(['wear_operation_version']);
      allow update, delete: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        !entryId.matches('wear-v1-.*') &&
        !resource.data.keys().hasAny(['wear_operation_version']);
    }

    // Idempotency keys and per-day wear receipts are exclusively server-owned.
    match /outfit_wear_receipts/{receiptId} {
      allow read, write: if false;
    }

    // Users can only read/write their own daily outfit suggestions
    match /daily_outfit_suggestions/{suggestionId} {
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
    }

    // Only admins can write to wardrobe_stats, all users can read
    match /wardrobe_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Trends: only authenticated users can read, only admins can write
    match /trends/{trendId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Image attempt budgets and publication fences are server-owned.
    match /garment_processing_jobs/{itemId} {
      allow read, write: if false;
    }

    // Draft revisions and completion history are written only by verified server APIs.
    match /onboarding_states/{userId} {
      allow read, write: if false;
    }

    // Deny all other access by default (CRITICAL SECURITY)
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 